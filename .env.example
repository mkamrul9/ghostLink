PORT=8080
HOST=0.0.0.0
MAX_CLIENTS=10000
# Optional product cap in bytes. Device/browser storage limits always apply.
# MAX_FILE_SIZE=10737418240
# Same-origin browser connections are allowed automatically.
# ALLOWED_ORIGINS=https://your-other-client.example
# Use your provider's STUN/TURN configuration. The app exposes these credentials to clients.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-relay.example:3478","username":"short-lived-user","credential":"short-lived-password"}]

MAX_ROOM_PEERS=6
# Optional coturn REST credentials. Leave unset for direct connections with STUN.
# TURN_URLS=["turn:relay.example:3478?transport=udp","turns:relay.example:5349?transport=tcp"]
# TURN_SECRET=use-a-random-secret-of-at-least-32-characters
# TURN_TTL=3600

{
  "name": "mystic-transfer",
  "version": "1.0.0",
  "description": "Private peer-to-peer file sharing and chat between devices.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.mjs && node scripts/build-pwa.mjs --check",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.e2e.js",
    "test:load": "node scripts/load-test.mjs",
    "verify": "npm run check && npm test && npm run test:e2e && npm run test:recovery && npm run test:local-folder && npm run test:group && npm run test:large && npm run test:mobile && npm run test:messages && npm run test:pwa",
    "test:mobile": "node tests/mobile.e2e.js",
    "build:crypto": "node scripts/build-crypto.mjs",
    "test:recovery": "node tests/recovery.e2e.js",
    "test:group": "node tests/group.e2e.js",
    "test:large": "node tests/large.e2e.js",
    "test:local-folder": "node tests/local-folder.e2e.js",
    "docs:screenshots": "node scripts/readme-screenshots.mjs",
    "check:deployment": "node scripts/deployment-check.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "test:messages": "node tests/messages.e2e.js",
    "test:pwa": "node tests/pwa.e2e.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkamrul9/mystic.git"
  },
  "keywords": [
    "file-sharing",
    "webrtc",
    "peer-to-peer",
    "privacy",
    "folder-sharing",
    "self-hosted"
  ],
  "author": "Mystic contributors",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mkamrul9/mystic/issues"
  },
  "homepage": "https://mystic-hgyb.onrender.com",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1"
  }
}

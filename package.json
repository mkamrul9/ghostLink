{
  "name": "mystic-transfer",
  "version": "1.0.0",
  "description": "Private peer-to-peer file sharing and chat between devices.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.e2e.js",
    "test:load": "node scripts/load-test.mjs",
    "verify": "npm run check && npm test && npm run test:e2e && npm run test:recovery && npm run test:mobile",
    "test:mobile": "node tests/mobile.e2e.js",
    "build:crypto": "node scripts/build-crypto.mjs",
    "test:recovery": "node tests/recovery.e2e.js"
  },

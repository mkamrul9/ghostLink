  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
